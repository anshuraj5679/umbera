# ─── Midnight Network Configuration ──────────────────────────────────────────
# Environment variables for UMBRA on Midnight Preview.
# Copy this file to .env.midnight and fill in your values.
# NEVER commit secrets to version control.

# ─── network ─────────────────────────────────────────────────────────────────
MIDNIGHT_NETWORK_ID=preview

# ─── Blockfrost-managed endpoints (recommended for Preview) ──────────────────
# Sign up at https://blockfrost.io for a Midnight Preview project ID.
MIDNIGHT_INDEXER_URL=https://midnight-preview.blockfrost.io/api/v0
MIDNIGHT_INDEXER_WS_URL=wss://midnight-preview.blockfrost.io/api/v0/ws
MIDNIGHT_NODE_URL=https://rpc.midnight-preview.blockfrost.io
BLOCKFROST_PROJECT_ID=

# ─── proof server (local Docker) ─────────────────────────────────────────────
# The proof server generates ZK proofs locally. It must run as a Docker
# container and MUST match the ledger version used by Preview.
PROOF_SERVER_URL=http://localhost:6300

# ─── contract ────────────────────────────────────────────────────────────────
# Deployed Compact contract address on Midnight Preview.
MIDNIGHT_CONTRACT_ADDRESS=

# ─── matcher service ─────────────────────────────────────────────────────────
# PostgreSQL (same as Fhenix version — operational state only).
RDS_URL=postgres://darkpool:${POSTGRES_PASSWORD}@localhost:5432/darkpool
POSTGRES_PASSWORD=
LOG_LEVEL=info
HTTP_PORT=8080

# Matcher operational config (preserved from V1).
MATCHER_CATCHUP_CHUNK_SIZE=500
MATCHER_CATCHUP_INTERVAL_SEC=30
MATCHER_BATCH_MATCH_DELAY_SEC=15
MATCHER_AUDIT_REPAIR_INTERVAL_SEC=300
MATCHER_INVARIANT_RECONCILE_INTERVAL_SEC=60
MATCHER_RETRY_WORKER_INTERVAL_SEC=20
MATCHER_RETRY_WORKER_BATCH_SIZE=50
MATCHER_TASK_LEASE_SEC=120
MATCHER_STALE_TASK_SWEEP_INTERVAL_SEC=60
MATCHER_STALE_TASK_AFTER_SEC=300
MATCHER_CORS_ORIGINS=

# ─── frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MIDNIGHT_NETWORK_ID=preview
NEXT_PUBLIC_MIDNIGHT_CONTRACT_ADDRESS=
MATCHER_API_URL=http://localhost:8080

# ─── assets (abstract — do NOT assume ERC-20 behavior) ───────────────────────
# Token configuration for trading pairs on Midnight.
TOKEN_A_NAME=Token A
TOKEN_A_DECIMALS=6
TOKEN_B_NAME=Token B
TOKEN_B_DECIMALS=18

# ─── x402 agent access (optional) ───────────────────────────────────────────
X402_AGENT_ENABLED=false
AGENT_ACCESS_TOKEN_SECRET=
AGENT_ACCESS_TOKEN_TTL_SEC=600
AGENT_ACCESS_MAX_USES=1
