# ─── chain ────────────────────────────────────────────────────
ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARB_SEPOLIA_WS_URL=wss://sepolia-rollup.arbitrum.io/ws
ETHERSCAN_API_KEY=

# ─── roles (testnet only — never commit prod keys) ───────────
ADMIN_PRIVATE_KEY=
MATCHER_PRIVATE_KEY=
FEE_COLLECTOR_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# ─── matcher service ─────────────────────────────────────────
RDS_URL=postgres://darkpool:${POSTGRES_PASSWORD}@localhost:5432/darkpool
POSTGRES_PASSWORD=
S3_BUCKET=darkpool-matcher-logs-dev
S3_REGION=ap-south-1
MATCHER_SECRET_ID=               # if set, overrides MATCHER_PRIVATE_KEY via Secrets Manager
LOG_LEVEL=info
HTTP_PORT=8080
MATCHER_CATCHUP_CHUNK_SIZE=500
MATCHER_CATCHUP_INTERVAL_SEC=30
MATCHER_EMPTY_BATCH_CLOSE_AFTER_SEC=0
MATCHER_BATCH_MATCH_DELAY_SEC=15
# Comma-separated browser origins allowed to call matcher directly. Prefer the Vercel URL in production.
MATCHER_CORS_ORIGINS=

# ─── x402 agent order API ───────────────────────────────────
# Default payment rail is x402.org on Base Sepolia. DEX execution stays on Arbitrum Sepolia.
X402_AGENT_ENABLED=false
X402_AGENT_FACILITATOR_URL=https://x402.org/facilitator
X402_AGENT_NETWORK=eip155:84532
X402_AGENT_PRICE=$0.01
X402_AGENT_PAY_TO=
X402_AGENT_SYNC_FACILITATOR_ON_START=true

# Delegated testnet trader used by POST /agent/orders after x402 payment.
# It must hold wrapped encrypted balances and will auto-set the DEX operator.
AGENT_TRADER_PRIVATE_KEY=
AGENT_ORDER_ALLOWED_PAIR_IDS=0,1,2,3
AGENT_ORDER_MAX_NOTIONAL_USDC=10000
AGENT_ORDER_MAX_EXPIRY_HOURS=24
AGENT_ORDER_DEV_BYPASS_TOKEN=
AGENT_ORDER_IDEMPOTENCY_SECRET=

# ─── maker bot runner ───────────────────────────────────────
# Dry-run by default. Live submission requires `npm --prefix matcher run maker:execute`.
MAKER_BOT_MODE=crossing
MAKER_BOT_PAIRS=0,1,2,3
MAKER_BOT_LEVELS=1
MAKER_BOT_MAX_ORDERS=8
MAKER_BOT_SEED=
MAKER_BOT_PROFILES_JSON=
DEMO_BATCH_DURATION_SEC=300
DEMO_DISPUTE_WINDOW_SEC=300

# ─── frontend ────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_DEX_ADDRESS=
# Vercel/server routes must use a public HTTPS matcher URL in production.
MATCHER_API_URL=http://localhost:8080
NEXT_PUBLIC_WALLETCONNECT_ID=
