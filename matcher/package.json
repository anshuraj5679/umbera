{
  "name": "@darkpool/matcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "maker:dry-run": "tsx scripts/maker-bot.ts --dry-run",
    "maker:execute": "tsx scripts/maker-bot.ts --execute",
    "ops:match-batch": "tsx scripts/rematch-batch.ts",
    "e2e:agent-order": "tsx scripts/agent-order-e2e.ts",
    "e2e:x402-challenge": "tsx scripts/x402-challenge-e2e.ts",
    "ops:scrub-private-tasks": "tsx scripts/scrub-private-task-data.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/client-secrets-manager": "^3.658.0",
    "@cofhe/sdk": "^0.5.2",
    "@x402/core": "^2.12.0",
    "@x402/evm": "^2.12.0",
    "@x402/express": "^2.12.0",
    "cofhejs": "0.3.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.34.0",
    "ethers": "^6.13.0",
    "express": "^4.21.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "viem": "^2.50.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.25.0",
    "fast-check": "^3.21.0",
    "testcontainers": "^10.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
