{
  "name": "darkpool-dex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <23", "pnpm": ">=9" },
  "scripts": {
    "build": "pnpm -r --filter='./contracts' --filter='./shared' --filter='./matcher' --filter='./frontend' build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "demo:market": "pnpm --dir frontend demo:market",
    "demo:market:configure": "pnpm --dir frontend demo:market:configure",
    "demo:market:seed": "pnpm --dir frontend demo:market:seed",
    "demo:market:orders": "pnpm --dir frontend demo:market:orders",
    "demo:market:close": "pnpm --dir frontend demo:market:close",
    "demo:market:status": "pnpm --dir frontend demo:market:status",
    "demo:operator": "pnpm --dir frontend demo:operator",
    "demo:settle": "pnpm --dir frontend demo:settle",
    "smoke:arbSepolia": "node -e \"console.error('smoke scripts land in Task F3 — run after contracts/ is built'); process.exit(1)\"",
    "smoke:dispute": "node -e \"console.error('smoke scripts land in Task F3 — run after contracts/ is built'); process.exit(1)\""
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.19.0"
  }
}
