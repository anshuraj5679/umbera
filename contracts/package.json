{
  "name": "@darkpool/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "postinstall": "node scripts/patch-cofhe-mocks.cjs",
    "build": "hardhat compile && tsx scripts/export-abi.ts",
    "test": "hardhat test && forge test",
    "test:hardhat": "hardhat test",
    "test:foundry": "forge test -vvv",
    "deploy:local": "hardhat run tasks/deploy.ts --network localhost",
    "deploy:arbSepolia": "hardhat run tasks/deploy.ts --network arbSepolia",
    "deploy:account-dex:arbSepolia": "hardhat run tasks/deploy-account-dex.ts --network arbSepolia",
    "add-demo-markets:arbSepolia": "hardhat run tasks/add-demo-markets.ts --network arbSepolia",
    "lint": "solhint 'src/**/*.sol'"
  },
  "dependencies": {
    "@fhenixprotocol/cofhe-contracts": "0.1.3",
    "@openzeppelin/contracts": "^5.0.2"
  },
  "devDependencies": {
    "@fhenixprotocol/cofhe-mock-contracts": "0.3.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.7",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.11",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.10",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.5.0",
    "chai": "^4.4.1",
    "cofhe-hardhat-plugin": "0.3.1",
    "cofhejs": "0.3.1",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "hardhat": "^2.22.10",
    "hardhat-gas-reporter": "^1.0.10",
    "solhint": "^5.0.3",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typechain": "^8.3.2",
    "typescript": "^5.5.4"
  }
}
